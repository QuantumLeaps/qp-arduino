 <directory name=".">
  <file name="bsp.hpp">
   <text>#ifndef BSP_HPP
#define BSP_HPP

class BSP {
public:
    enum { TICKS_PER_SEC = 100 };
    static void init();
    static void ledOff();
    static void ledOn();

    // application dictionaries, re-emitted periodically in the transmit-only
    // trace profile (QP_ARDUINO_QS_DICT_PERIOD_MS)
    static void setDictionaryHook(void (*hook)());
};

#endif // BSP_HPP
</text>
  </file>
  <file name="bsp.cpp">
   <text>// Board Support Package for the RP2040 Blinky example: Earle Philhower
// arduino-pico core, QP/C++ v7.3.4 QV kernel.
//
// Compile-time configuration (build_flags in platformio.ini):
//
//   QP_ARDUINO_LED_PIN (default LED_BUILTIN, GP25 on a Raspberry Pi Pico)
//       The GPIO the Blinky active object toggles. Set it for a board whose
//       core defines no LED_BUILTIN or whose LED is somewhere else.
//   QP_ARDUINO_TICK_PROBE_PIN (default: not defined)
//       Optional GPIO pulsed by the tick callback for a logic analyzer or
//       oscilloscope: the pulse is the callback's duration and the pulse
//       period is the tick. Must differ from the LED and trace pins.
//   QS_ON
//       Emit QS trace records over QP_ARDUINO_QS_SERIAL (default Serial, the
//       USB CDC port; Serial1 is UART0 on GP0/GP1). QSPY:
//       qspy -c /dev/ttyACM0 -b 115200
//   QP_ARDUINO_QS_HOST_WAIT_MS (default 5000)
//       USB CDC discards everything written before a host opens the port, so
//       the QS dictionaries emitted at start-up would be lost. The BSP waits
//       up to this long for a host (DTR) before starting QS; a UART transport
//       reports "connected" immediately, so the wait costs nothing there.
//       Define it as 0 to boot without waiting.
//   QP_ARDUINO_QS_SERVICE_US (default 1000), QP_ARDUINO_QS_SERVICE_BYTES (64)
//       The idle loop touches the transport only when at least this many QS
//       bytes are pending or this much time has passed. Every call into the
//       USB CDC port runs TinyUSB's task, which is what inflated the tick and
//       dispatch timings measured with the transport serviced on every pass.
//   QP_ARDUINO_QS_TX_ONLY (default 0)
//       Transmit-only observation profile: QS-RX is never read or parsed, so
//       the target accepts no reset, poke, event injection or command from the
//       trace link. Meant for the UART transport during experiments.
//   QP_ARDUINO_QS_DICT_PERIOD_MS (default 0 = off)
//       Re-emit the QS dictionaries (the BSP's and the application's, through
//       BSP::setDictionaryHook) this often, so a capture that misses boot is
//       still decodable by itself.
//   QP_ARDUINO_QS_STAT_PERIOD_MS (default 0 = off)
//       Emit a TRACE_STAT user record this often with the QS buffer's fill
//       high-water mark and the number of times it was found completely full
//       (QS then overwrites its oldest bytes, which the host sees as a
//       sequence discontinuity), so trace loss is reported from the target.
//   QP_ARDUINO_QS_PIO_TX_PIN (default: not defined)
//       Send QS over a transmit-only PIO UART on this GPIO instead of a
//       hardware serial port (arduino-pico SerialPIO with no RX pin). Any
//       free GPIO works, so a board whose hardware UARTs are all spoken for
//       can still carry the trace to a logic analyzer or a USB-UART adapter.
//       The link has no receive side; combine with QP_ARDUINO_QS_TX_ONLY=1.
//       Mutually exclusive with QP_ARDUINO_QS_SERIAL.
//   QP_ARDUINO_QS_BAUD (default 115200)
//       Baud rate of a UART or PIO UART transport; USB CDC ignores it.
//
#include "qpcpp.hpp"   // QP/C++ framework
#include "blinky.hpp"  // Blinky application interface
#include "bsp.hpp"     // Board Support Package

#include &lt;pico/time.h&gt;          // time_us_64(), from_us_since_boot()
#include &lt;hardware/timer.h&gt;     // hardware_alarm_*()
#include &lt;hardware/watchdog.h&gt;  // watchdog_reboot()

using namespace QP;

Q_DEFINE_THIS_FILE

#if defined(QP_ARDUINO_QS_PIO_TX_PIN)
#if defined(QP_ARDUINO_QS_SERIAL)
#error "QP_ARDUINO_QS_PIO_TX_PIN and QP_ARDUINO_QS_SERIAL are mutually exclusive"
#endif
#define QP_ARDUINO_QS_SERIAL l_qsPioSerial // transmit-only PIO UART, defined below
#elif !defined(QP_ARDUINO_QS_SERIAL)
#define QP_ARDUINO_QS_SERIAL Serial
#endif
#ifndef QP_ARDUINO_QS_BAUD
#define QP_ARDUINO_QS_BAUD 115200U
#endif
#ifndef QP_ARDUINO_QS_HOST_WAIT_MS
#define QP_ARDUINO_QS_HOST_WAIT_MS 5000U
#endif
#ifndef QP_ARDUINO_QS_SERVICE_US
#define QP_ARDUINO_QS_SERVICE_US 1000U
#endif
#ifndef QP_ARDUINO_QS_SERVICE_BYTES
#define QP_ARDUINO_QS_SERVICE_BYTES 64U
#endif
#ifndef QP_ARDUINO_QS_TX_ONLY
#define QP_ARDUINO_QS_TX_ONLY 0
#endif
#ifndef QP_ARDUINO_QS_DICT_PERIOD_MS
#define QP_ARDUINO_QS_DICT_PERIOD_MS 0U
#endif
#ifndef QP_ARDUINO_QS_STAT_PERIOD_MS
#define QP_ARDUINO_QS_STAT_PERIOD_MS 0U
#endif

enum BspRecords { // BSP-level QS user records
    TRACE_STAT = QP::QS_USER + 8,
    TICK_LOST = QP::QS_USER + 9
};

namespace {

//----------------------------------------------------------------------------
// Pins
#ifdef QP_ARDUINO_LED_PIN
constexpr std::uint8_t kLedPin = QP_ARDUINO_LED_PIN;
#else
constexpr std::uint8_t kLedPin = LED_BUILTIN; // GP25 on a Raspberry Pi Pico
#endif
#ifdef QP_ARDUINO_TICK_PROBE_PIN
constexpr std::uint8_t kTickProbePin = QP_ARDUINO_TICK_PROBE_PIN;
#define BSP_HAS_TICK_PROBE 1
#else
#define BSP_HAS_TICK_PROBE 0
#endif

#if BSP_HAS_TICK_PROBE
inline void tickProbe(PinStatus level) { digitalWrite(kTickProbePin, level); }
#else
inline void tickProbe(PinStatus) {}
#endif

#if defined(QP_ARDUINO_QS_PIO_TX_PIN)
// Transmit-only PIO UART for the QS trace. SerialPIO reports the free space of
// its 8-entry PIO FIFO through availableForWrite() and blocks in write() only
// when that FIFO is full, which qsTransmitSome() below never lets happen, so
// the transport discipline is the same as for a hardware port: the idle loop
// hands over at most eight bytes per service pass.
SerialPIO l_qsPioSerial(QP_ARDUINO_QS_PIO_TX_PIN, SerialPIO::NOPIN);
static_assert(QP_ARDUINO_QS_PIO_TX_PIN != kLedPin,
              "the PIO trace pin is the LED pin");
#if BSP_HAS_TICK_PROBE
static_assert(QP_ARDUINO_QS_PIO_TX_PIN != kTickProbePin,
              "the PIO trace pin is the tick probe; move it with QP_ARDUINO_TICK_PROBE_PIN");
#endif
#endif

QP::QSpyId const l_TICK_ID = { 0U }; // QS source of the tick

//----------------------------------------------------------------------------
// System clock tick: a hardware timer alarm owned by this BSP.
//
// Earlier revisions used the pico-sdk repeating timer, which lives in the
// default alarm pool shared with the core's USB task and delay(). On
// 2026-09-30 that tick silently stopped after a few minutes of trace-host
// attach/detach cycling while QS-RX, QS-TX and the QV loop kept running: an
// alarm pool re-add can fail and the repeating timer then simply ends. A
// claimed hardware alarm re-armed from its own interrupt has no shared
// bookkeeping. The idle loop also watches the tick and re-arms it, reporting
// the event as a TICK_LOST record, so a stopped tick can never be silent.
constexpr std::uint32_t kTickPeriodUs = 1000000U / BSP::TICKS_PER_SEC;
int l_tickAlarm = -1;                        // hardware alarm number, claimed at start-up
std::uint64_t l_tickTarget = 0U;             // absolute time (us) of the next tick
std::uint32_t volatile l_tickCount = 0U;     // ticks delivered
std::uint32_t volatile l_tickCatchUps = 0U;  // targets already in the past when re-armed
std::uint32_t volatile l_tickRearms = 0U;    // watchdog re-arms from the idle loop
std::uint32_t volatile l_lastTick_us = 0U;   // micros() at the last tick

void armTick() { // program the alarm for l_tickTarget, catching up if it already passed
    while (hardware_alarm_set_target(static_cast&lt;uint&gt;(l_tickAlarm),
                                     from_us_since_boot(l_tickTarget)))
    {
        l_tickTarget += kTickPeriodUs; // missed: move on without stopping
        ++l_tickCatchUps;
    }
}
void tickAlarmCallback(uint) {
    tickProbe(HIGH);
    l_tickTarget += kTickPeriodUs;
    armTick(); // re-arm first so a slow tick never loses the next one
    ++l_tickCount;
    l_lastTick_us = micros();
    QTimeEvt::tick(0U, &amp;l_TICK_ID); // process time events for tick rate 0
    tickProbe(LOW);
}
void startTick() {
    l_tickAlarm = hardware_alarm_claim_unused(true); // panics if none is free
    hardware_alarm_set_callback(static_cast&lt;uint&gt;(l_tickAlarm), &amp;tickAlarmCallback);
    l_tickTarget = time_us_64() + kTickPeriodUs;
    l_lastTick_us = micros();
    armTick();
}
void tickWatchdog() { // idle loop: if the alarm ever stops, report it and re-arm
    // Read the tick's timestamp BEFORE the clock: the tick interrupt can land
    // between the two reads, and reading the clock first would then see a
    // "last tick" from the future and wrap to a huge elapsed time. That race
    // produced 20,098 spurious re-arms in the first hour-long run.
    std::uint32_t const last = l_lastTick_us;
    std::int32_t const elapsed = static_cast&lt;std::int32_t&gt;(micros() - last);
    if (elapsed &gt; static_cast&lt;std::int32_t&gt;(5U * kTickPeriodUs)) {
        ++l_tickRearms;
        QS_BEGIN_ID(TICK_LOST, 0U)
            QS_U32(0U, l_tickCount);
            QS_U32(0U, l_tickRearms);
            QS_U32(0U, l_tickCatchUps);
        QS_END()
        l_tickTarget = time_us_64() + kTickPeriodUs;
        l_lastTick_us = micros();
        armTick();
    }
}

//----------------------------------------------------------------------------
// QS transport helpers
//
// The Arduino port always compiles the framework with Q_SPY, so the QS
// callbacks below must exist even when QS_ON is not defined; QS_ON only
// decides whether QS is started and serviced.

/// QS transport helpers. USB CDC is drained by an interrupt on this core and
// discards nothing once a host is attached, but it accepts only what fits in
// its FIFO. Never take more out of the QS buffer than the port will accept
// right now: QS::getBlock() advances the buffer, so bytes taken and not written
// would be lost mid-record and the host would see checksum errors.
void (*l_dictionaryHook)() = nullptr;
std::uint32_t l_qsHighWater = 0U;   // max QS bytes pending since the last TRACE_STAT
std::uint32_t l_qsSaturations = 0U; // times the QS buffer was found completely full
bool l_qsNoFlush = false;           // set while re-emitting dictionaries from the idle loop

// True when the transport should be touched on this idle pass. Every call
// into the USB CDC port runs TinyUSB's task, which inflated the tick and
// dispatch timings when the transport was serviced on every pass.
bool qsServiceDue() {
    static std::uint32_t last_us = 0U;
    std::uint32_t const now = micros();
    std::uint32_t const pending = QP::QS::priv_.used; // volatile, read once
    if (pending &gt; l_qsHighWater) {
        l_qsHighWater = pending;
    }
    if (pending &gt;= QP::QS::priv_.end) {
        ++l_qsSaturations;
    }
    if ((pending &lt; QP_ARDUINO_QS_SERVICE_BYTES) &amp;&amp; ((now - last_us) &lt; QP_ARDUINO_QS_SERVICE_US)) {
        return false;
    }
    last_us = now;
    return true;
}

// QS::getBlock() changes the ring buffer's shared state and must run with
// interrupts disabled, as every upstream Cortex-M BSP does: a record written
// from an interrupt (the tick's AO-Post with the full record set) otherwise
// races with the drain. Found 2026-10-01 under an application-shaped load as corrupt
// records and resets; the profiles that emit nothing from interrupts never
// showed it.
std::uint8_t const *qsTakeBlock(std::uint16_t *len) {
    QF_INT_DISABLE();
    std::uint8_t const * const buf = QS::getBlock(len);
    QF_INT_ENABLE();
    return buf;
}

void qsTransmitSome() {
    int const room = QP_ARDUINO_QS_SERIAL.availableForWrite();
    if (room &gt; 0) {
        std::uint16_t len = (room &gt; 0xFFFF) ? 0xFFFFU : static_cast&lt;std::uint16_t&gt;(room);
        std::uint8_t const * const buf = qsTakeBlock(&amp;len);
        if (buf != nullptr) {
            static_cast&lt;void&gt;(QP_ARDUINO_QS_SERIAL.write(buf, len)); // fits by construction
        }
    }
}

// Drain the QS buffer until it is empty or the transport stops accepting data
// for timeout_us. Whatever is left stays in the QS buffer.
void qsFlushBounded(std::uint32_t timeout_us) {
    std::uint32_t start = micros();
    for (;;) {
        int const room = QP_ARDUINO_QS_SERIAL.availableForWrite();
        if (room &gt; 0) {
            std::uint16_t len = (room &gt; 0xFFFF) ? 0xFFFFU : static_cast&lt;std::uint16_t&gt;(room);
            std::uint8_t const * const buf = qsTakeBlock(&amp;len);
            if (buf == nullptr) {
                return; // nothing left
            }
            static_cast&lt;void&gt;(QP_ARDUINO_QS_SERIAL.write(buf, len));
            start = micros(); // progress was made
        }
        else if ((micros() - start) &gt; timeout_us) {
            return; // transport is not draining
        }
    }
}

void bspDictionaries() {
    QS_OBJ_DICTIONARY(&amp;l_TICK_ID);
    QS_USR_DICTIONARY(TRACE_STAT);
    QS_USR_DICTIONARY(TICK_LOST);
}

// Periodic work done from the idle loop in the trace profiles.
void qsPeriodic() {
#if (QP_ARDUINO_QS_DICT_PERIOD_MS &gt; 0U)
    static std::uint32_t lastDict_ms = 0U;
    if ((millis() - lastDict_ms) &gt;= QP_ARDUINO_QS_DICT_PERIOD_MS) {
        lastDict_ms = millis();
        // Every QS dictionary function ends with QS::onFlush(), which drains
        // the buffer synchronously: at 115200 baud that held the idle loop,
        // and every active object with it, for about 30 ms per period (found
        // 2026-10-01 under an application-shaped load as late completions every
        // 10 s). Let the periodic copies drain through the normal service.
        l_qsNoFlush = true;
        bspDictionaries();
        if (l_dictionaryHook != nullptr) {
            l_dictionaryHook();
        }
        l_qsNoFlush = false;
    }
#endif
#if (QP_ARDUINO_QS_STAT_PERIOD_MS &gt; 0U)
    static std::uint32_t lastStat_ms = 0U;
    if ((millis() - lastStat_ms) &gt;= QP_ARDUINO_QS_STAT_PERIOD_MS) {
        lastStat_ms = millis();
        QS_BEGIN_ID(TRACE_STAT, 0U)
            QS_U32(0U, l_qsHighWater);    // QS bytes pending, high-water mark
            QS_U32(0U, l_qsSaturations);  // buffer-full observations (data overwritten)
            QS_U16(0U, QP::QS::priv_.end); // buffer size
            QS_U32(0U, l_tickCount);      // ticks delivered so far
        QS_END()
        l_qsHighWater = 0U;
        l_qsSaturations = 0U;
    }
#endif
}

} // unnamed namespace

//----------------------------------------------------------------------------
// BSP functions
void BSP::init() {
    pinMode(kLedPin, OUTPUT);
    digitalWrite(kLedPin, LOW);
#if BSP_HAS_TICK_PROBE
    pinMode(kTickProbePin, OUTPUT);
    digitalWrite(kTickProbePin, LOW);
#endif

#ifdef QS_ON
#if !QP_ARDUINO_QS_TX_ONLY
    // Give a trace host the chance to attach before the dictionaries go out.
    // Nothing has started yet, so waiting here is harmless.
    {
        std::uint32_t const start = millis();
        while (!QP_ARDUINO_QS_SERIAL
               &amp;&amp; ((millis() - start) &lt; QP_ARDUINO_QS_HOST_WAIT_MS))
        {
            delay(10);
        }
    }
#endif
    QS_INIT(nullptr);
    bspDictionaries();
    QS_GLB_FILTER(QP::QS_SM_RECORDS); // state machine records
    QS_GLB_FILTER(QP::QS_AO_RECORDS); // active object records
    QS_GLB_FILTER(QP::QS_UA_RECORDS); // all user records
#endif
}
//............................................................................
void BSP::setDictionaryHook(void (*hook)()) {
    l_dictionaryHook = hook;
}
//............................................................................
void BSP::ledOff() {
    digitalWrite(kLedPin, LOW);
}
//............................................................................
void BSP::ledOn() {
    digitalWrite(kLedPin, HIGH);
}

//----------------------------------------------------------------------------
// QF callbacks
void QF::onStartup() {
    startTick(); // interrupts start here, after the AOs are started
}
//............................................................................
void QF::onCleanup() {
}
//............................................................................
void QV::onIdle() { // called with interrupts DISABLED, see NOTE in qv.hpp
#ifdef QS_ON
    QF_INT_ENABLE(); // re-enable interrupts before touching the transport

    tickWatchdog();
    qsPeriodic();
    if (qsServiceDue()) {
        qsTransmitSome(); // QS transmit
#if !QP_ARDUINO_QS_TX_ONLY
        // QS receive (bench profile: QSPY/QUTest can talk back over the port)
        int avail = QP_ARDUINO_QS_SERIAL.available();
        if (avail &gt; 0) {
            do {
                QS::rxPut(static_cast&lt;std::uint8_t&gt;(QP_ARDUINO_QS_SERIAL.read()));
            } while (--avail &gt; 0);
            QS::rxParse();
        }
#endif
    }
#else
    QF_INT_ENABLE();
    tickWatchdog();
    QF_INT_DISABLE();
    // Sleep until the next interrupt; QV_CPU_SLEEP() re-enables interrupts
    // atomically with WFI on ARMv6-M. USB is serviced from an interrupt on
    // this core, so it keeps working.
    QV_CPU_SLEEP();
#endif
}
//............................................................................
extern "C" Q_NORETURN Q_onError(char const * const module, int const id) {
#ifdef QS_ON
    // Try to get the assertion record out while interrupts may still be
    // running; QS::onFlush() below is bounded so this cannot hang.
    QS_ASSERTION(module, id, 0U);
#else
    Q_UNUSED_PAR(module);
    Q_UNUSED_PAR(id);
#endif
    __asm volatile ("cpsid i" ::: "memory"); // disable interrupts directly

    // Distinct analyzer signature: LED solid on for two seconds, tick probe
    // silent, then a watchdog reset so a board with no reset button recovers
    // on its own.
    digitalWrite(kLedPin, HIGH);
    std::uint32_t const start = micros();
    while ((micros() - start) &lt; 2000000U) {
    }
    watchdog_reboot(0U, 0U, 10U);
    for (;;) {
    }
}

//----------------------------------------------------------------------------
// QS callbacks (always defined; see the note above)
bool QS::onStartup(void const *arg) {
    Q_UNUSED_PAR(arg);
    static std::uint8_t qsTxBuf[2048]; // QS transmit buffer
    static std::uint8_t qsRxBuf[128];  // QS receive buffer
    initBuf(qsTxBuf, sizeof(qsTxBuf));
    rxInitBuf(qsRxBuf, sizeof(qsRxBuf));
    QP_ARDUINO_QS_SERIAL.begin(QP_ARDUINO_QS_BAUD); // ignored by USB CDC
    return true;
}
//............................................................................
void QS::onCleanup() {
}
//............................................................................
QSTimeCtr QS::onGetTime() {
    return static_cast&lt;QSTimeCtr&gt;(micros()); // 1 us resolution, wraps at 32 bits
}
//............................................................................
void QS::onFlush() {
    if (!l_qsNoFlush) {
        qsFlushBounded(200000U); // wait at most 200 ms for the transport
    }
}
//............................................................................
void QS::onReset() {
    watchdog_reboot(0U, 0U, 10U);
    for (;;) {
    }
}
//............................................................................
void QS::onCommand(std::uint8_t cmdId, std::uint32_t param1,
                   std::uint32_t param2, std::uint32_t param3)
{
    Q_UNUSED_PAR(cmdId);
    Q_UNUSED_PAR(param1);
    Q_UNUSED_PAR(param2);
    Q_UNUSED_PAR(param3);
}
</text>
