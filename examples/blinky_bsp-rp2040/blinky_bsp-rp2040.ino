// Blinky for RP2040 boards on the Earle Philhower arduino-pico core, using the
// QP/C++ v7.3.4 QV cooperative kernel from qp-arduino.
//
// One active object toggles the "LED" every half second from a QP time event.
// Everything hardware-specific -- the tick timer, which pin the LED is, the
// fixture's safe state and the QS trace transport -- lives in bsp.cpp. This
// file and blinky.hpp are board-independent.
//
// Build environments (platformio.ini):
//   rp2040_mouse_joystick  mouse-joystick-pcb rev 0 fixture; LED = GP25 =
//                          FW_TRIG0 = InstrumentPort-40 TRIG0 = LA5032 ch 16.
//
// Handwritten for qp-arduino (QP/C++ v7.3.4). Not generated by QM.
#include "qpcpp.hpp"   // QP/C++ framework
#include "blinky.hpp"  // Blinky application interface
#include "bsp.hpp"     // Board Support Package

using namespace QP;

#if (QP_VERSION < 730U)
#error qpcpp version 7.3.0 or higher required
#endif

//............................................................................
void setup() {
    QF::init();  // initialize the framework
    BSP::init(); // initialize the board (safe state, LED, QS)

    static QEvt const *blinky_queueSto[10];
    AO_Blinky->start(1U, // QP priority
                     blinky_queueSto, Q_DIM(blinky_queueSto),
                     nullptr, 0U); // no per-AO stack under QV
}

//............................................................................
void loop() {
    QF::run(); // QV kernel: runs the active objects and never returns
}

//============================================================================
// Blinky active object
class Blinky : public QActive {
private:
    QTimeEvt m_timeEvt;

public:
    static Blinky instance;
    Blinky();

protected:
    Q_STATE_DECL(initial);
    Q_STATE_DECL(off);
    Q_STATE_DECL(on);
};

Blinky Blinky::instance;
QActive * const AO_Blinky = &Blinky::instance;

//............................................................................
Blinky::Blinky()
  : QActive(Q_STATE_CAST(&Blinky::initial)),
    m_timeEvt(this, TIMEOUT_SIG, 0U)
{}

//............................................................................
Q_STATE_DEF(Blinky, initial) {
    Q_UNUSED_PAR(e);
#ifdef QS_ON
    QS_OBJ_DICTIONARY(&Blinky::instance);
    QS_OBJ_DICTIONARY(&m_timeEvt);
    QS_SIG_DICTIONARY(TIMEOUT_SIG, this);
    QS_FUN_DICTIONARY(&Blinky::off);
    QS_FUN_DICTIONARY(&Blinky::on);
#endif
    // periodic time event: every TICKS_PER_SEC/2 ticks, i.e. 2 Hz toggling
    m_timeEvt.armX(BSP::TICKS_PER_SEC / 2U, BSP::TICKS_PER_SEC / 2U);
    return tran(&off);
}
//............................................................................
Q_STATE_DEF(Blinky, off) {
    QState status_;
    switch (e->sig) {
        case Q_ENTRY_SIG: {
            BSP::ledOff();
            status_ = Q_RET_HANDLED;
            break;
        }
        case TIMEOUT_SIG: {
            status_ = tran(&on);
            break;
        }
        default: {
            status_ = super(&top);
            break;
        }
    }
    return status_;
}
//............................................................................
Q_STATE_DEF(Blinky, on) {
    QState status_;
    switch (e->sig) {
        case Q_ENTRY_SIG: {
            BSP::ledOn();
            status_ = Q_RET_HANDLED;
            break;
        }
        case TIMEOUT_SIG: {
            status_ = tran(&off);
            break;
        }
        default: {
            status_ = super(&top);
            break;
        }
    }
    return status_;
}
