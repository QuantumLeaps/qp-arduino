// qp-arduino RP2040 port-validation sketch (QP/C++ v7.3.4, QV kernel, Earle
// Philhower arduino-pico core). Builds for any board of that core; the
// Raspberry Pi Pico is the reference.
//
// A single Validator active object generates load every tick: it publishes
// VALIDATE_SIG to itself, allocates a dynamic ValidationEvt from the pool,
// posts it to itself and checks its sequence number. Every 100 dynamic events
// it emits a VALIDATION_STAT user record with its counters.
//
// Probes, for a logic analyzer or oscilloscope:
//   QP_ARDUINO_TICK_PROBE_PIN (optional): high during the tick callback
//   the LED pin (LED_BUILTIN, GP25 on a Pico, or QP_ARDUINO_LED_PIN): its
//       role is selected at run time by QS command 5:
//       0 marker pulses (entry of `running`, command 3)
//       1 high while the Validator dispatches an event      (default)
//       2 high while the QV idle callback runs
//       3 pulse on receipt of each dynamic event
//
// QS commands (host driven through QSPY, see tools/port_validation_rp2040.py):
//   1 publish VALIDATE_SIG           5 select the LED-pin role (param1)
//   2 post a dynamic event, seq=p1   6 emit VALIDATION_STAT now
//   3 pulse the marker (role 0)      7 reset the counters
//   4 provoke an assertion (Q_ERROR); the BSP records it and reboots
//
// Build flags as for blinky_bsp-rp2040: QP_ARDUINO_QS_OFF, QP_ARDUINO_QS_SERIAL,
// QP_ARDUINO_QS_HOST_WAIT_MS, QP_ARDUINO_LED_PIN, QP_ARDUINO_TICK_PROBE_PIN.
// Handwritten; not generated by QM.

#include "qpcpp.hpp"
#include "validation.hpp"
#include "bsp.hpp"

using namespace QP;

void setup() {
    QF::init();
    BSP::init(); // safe state, probes, QS

    static QSubscrList subscrSto[MAX_PUB_SIG];
    QActive::psInit(subscrSto, Q_DIM(subscrSto));

    static QF_MPOOL_EL(ValidationEvt) evtPoolSto[16];
    QF::poolInit(evtPoolSto, sizeof(evtPoolSto), sizeof(evtPoolSto[0]));

    static QEvt const *validatorQueueSto[16];
    AO_Validator->start(1U, validatorQueueSto, Q_DIM(validatorQueueSto),
                        nullptr, 0U);
}

void loop() {
    QF::run(); // QV kernel: never returns
}
